# TreaderAPP AWS Production Environment Configuration
# ====================================================================
# 사용법: 이 파일을 복사하여 env.conf 로 만들고 값을 설정하세요
# cp env.conf.example /app/treader/env.conf && chmod 600 /app/treader/env.conf
# ====================================================================

# ====================================================================
# 데이터베이스 (MariaDB RDS)
# ====================================================================
# RDS 엔드포인트 확인: aws rds describe-db-instances --db-instance-identifier treader-mariadb-prod --query 'DBInstances[0].Endpoint.Address'
export SPRING_DATASOURCE_URL=jdbc:mariadb://treader-mariadb-prod.xxxxx.ap-northeast-2.rds.amazonaws.com:3306/treader_db

# RDS 사용자명
export SPRING_DATASOURCE_USERNAME=treader_user

# RDS 비밀번호. 이 파일에 평문으로 들어가므로 chmod 600 으로 막을 것.
export SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# MariaDB JDBC 드라이버
export SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

# JPA/Hibernate 설정
export SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
export SPRING_JPA_HIBERNATE_DDL_AUTO=validate  # 프로덕션: validate (자동 스키마 생성 비활성)
export SPRING_JPA_SHOW_SQL=false

# ====================================================================
# 인증 (JWT)
# ====================================================================
# JWT 서명키. 최소 32바이트. openssl rand -base64 48 로 만들어 넣는다.
# 저장소의 개발용 기본값을 그대로 쓰면 누구나 토큰을 위조할 수 있다.
export APP_JWT_SECRET=your-secure-jwt-secret-key-minimum-32-bytes

# JWT 토큰 유효 시간 (분)
export APP_JWT_VALIDITY_MINUTES=30

# ====================================================================
# 프론트엔드 URL
# ====================================================================
# 인증 메일의 링크가 가리킬 주소. React 는 WAR 에 들어 있어 백엔드와 같은 오리진이다.
# 도메인을 붙이기 전에는 EC2 공인 IP 를 쓴다.
export APP_FRONTEND_BASE_URL=http://<EC2_공인_IP>:8080

# ====================================================================
# 이메일 (AWS SES)
# ====================================================================
# AWS SES SMTP 엔드포인트 (리전별로 다름)
# ap-northeast-2: email-smtp.ap-northeast-2.amazonaws.com
# us-east-1: email-smtp.us-east-1.amazonaws.com
export SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com

export SPRING_MAIL_PORT=587

# AWS SES SMTP 사용자명
export SPRING_MAIL_USERNAME=YOUR_SES_USERNAME

# AWS SES SMTP 비밀번호
export SPRING_MAIL_PASSWORD=YOUR_SES_PASSWORD

# 발신자 메일 주소
export APP_MAIL_FROM=noreply@yourdomain.com

# ====================================================================
# 파일 업로드
# ====================================================================
# 업로드 파일 저장 경로 (EBS 볼륨)
export APP_UPLOAD_DIR=/app/uploads

# 최대 파일 크기 (기본: 10MB)
export SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB

# 최대 요청 크기 (기본: 50MB)
export SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# ====================================================================
# 로깅
# ====================================================================
# 로그 파일 경로
export LOGGING_FILE_NAME=/app/logs/treader.log

# 로그 파일 최대 크기
export LOGGING_FILE_MAX_SIZE=10MB

# 로그 파일 보관 기간 (일)
export LOGGING_FILE_MAX_HISTORY=30

# 로그 레벨 (TRACE, DEBUG, INFO, WARN, ERROR)
export LOGGING_LEVEL_ROOT=INFO
export LOGGING_LEVEL_COM_EDU_BOOTSTRING=DEBUG

# ====================================================================
# 배치 작업 (선택)
# ====================================================================
# Korea Exim Bank API 키 (환율 배치용)
export APP_EXIM_BANK_API_KEY=YOUR_API_KEY

# ====================================================================
# API 문서 (springdoc)
# ====================================================================
# 운영에서는 API 스펙과 Swagger UI 를 공개하지 않는다.
# 켜 두면 /v3/api-docs 로 전체 엔드포인트 구조가 인증 없이 노출된다.
export SPRINGDOC_API_DOCS_ENABLED=false
export SPRINGDOC_SWAGGER_UI_ENABLED=false

# ====================================================================
# 기타
# ====================================================================
# 애플리케이션 포트
export SERVER_PORT=8080

# 타임존
export TZ=Asia/Seoul
