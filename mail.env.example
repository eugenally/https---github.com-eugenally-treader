# Gmail SMTP 로 실제 메일을 보내려면 이 파일을 mail.env 로 복사해 값을 채운다.
# mail.env 는 .gitignore 에 들어 있어 커밋되지 않는다. 파일이 없으면 MailHog(localhost:1025)로 보낸다.
# SPRING_MAIL_PASSWORD 는 Gmail 로그인 비밀번호가 아니라 '앱 비밀번호'(16자리, 공백 제거)다.
# 서버에서는 같은 이름으로 /app/treader/env.conf 에 넣는다 (treader.service 가 읽는다).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-account@gmail.com
SPRING_MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=your-account@gmail.com

# 인증 메일 링크가 가리킬 프론트엔드 주소 (로컬 vite 개발서버: http://localhost:5173)
APP_FRONTEND_BASE_URL=http://localhost:5173
